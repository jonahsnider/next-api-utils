{
	"name": "next-api-utils",
	"version": "3.1.2",
	"description": "Utilities for building maintainable backend APIs for the Next.js app router.",
	"keywords": [
		"api",
		"next",
		"nextjs"
	],
	"homepage": "https://next-api-utils.jonahsnider.dev",
	"bugs": {
		"url": "https://github.com/jonahsnider/next-api-utils/issues"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/next-api-utils.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.{js,d.ts}"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"docs": "typedoc",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test run",
		"test:coverage": "vp test run --coverage",
		"validate-api": "api-extractor run",
		"validate-api:local": "api-extractor run --local --verbose",
		"check": "vp check",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"knip": "knip",
		"prepare": "vp config"
	},
	"dependencies": {
		"@jonahsnider/util": "^12.0.0"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.60.0",
		"@tsconfig/recommended": "1.0.13",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@vitest/coverage-v8": "catalog:",
		"knip": "6.44.0",
		"next": "16.4.3",
		"react": "19.3.1",
		"typedoc": "0.28.20",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"next": "^15 || ^16.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": false
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
