{
	"name": "next-api-utils",
	"version": "3.0.2",
	"description": "Utilities for building maintainable backend APIs for the Next.js app router.",
	"keywords": [
		"api",
		"next",
		"nextjs"
	],
	"homepage": "https://next-api-utils.jonahsnider.dev",
	"bugs": {
		"url": "https://github.com/jonahsnider/next-api-utils/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/next-api-utils.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonahsnider.com",
		"url": "https://jonahsnider.com"
	},
	"type": "module",
	"exports": {
		"./default": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"!dist/**/*.test.{js,d.ts}"
	],
	"scripts": {
		"build": "zshy",
		"docs": "typedoc",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"test": "tsx --test src/**/*.test.ts",
		"test:coverage": "mkdir -p coverage && tsx --test-reporter=lcov --experimental-test-coverage --test-reporter-destination=coverage/lcov.info --test src/**/*.test.ts",
		"validate-api": "api-extractor run",
		"validate-api:local": "api-extractor run --local --verbose"
	},
	"prettier": "@jonahsnider/prettier-config",
	"dependencies": {
		"@jonahsnider/util": "^13.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@jonahsnider/prettier-config": "2.0.1",
		"@microsoft/api-extractor": "7.59.0",
		"@tsconfig/next": "2.0.6",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.13.3",
		"@types/react": "^19.0.0",
		"next": "16.3.4",
		"react": "19.2.8",
		"tsx": "4.23.13",
		"typedoc": "0.28.20",
		"typescript": "6.0.3",
		"zod": "4.5.4",
		"zshy": "0.7.3"
	},
	"peerDependencies": {
		"next": "^15 || ^16.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": false
		}
	},
	"packageManager": "pnpm@12.2.1",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"zshy": {
		"cjs": false,
		"exports": {
			"./default": "./src/index.ts",
			"./client": "./src/client.ts",
			"./server": "./src/server.ts"
		}
	}
}
